{{!< default}}
{{!--
    All Commentarii Mundi reports — /commentarii-mundi/berichte/

    Rendered by a routes.yaml channel:

      /commentarii-mundi/berichte/:
        controller: channel
        template: cm-reports
        filter: tag:hash-commentarii-mundi

    This is where "Weitere Berichte laden" on the landing page goes.

    Required, not optional: #commentarii-mundi is an internal tag, and Ghost gives
    internal tags no public archive page. There is no /tag/... fallback for the full
    report list, so this channel is the only route to it.

    Uses Source's .gh-feed for infinite scroll.
--}}

{{!-- Master switch: the CM layout renders only while the page with slug
     "commentarii-mundi" is published. Otherwise this route falls back to Source's
     ordinary archive (see docs/commentarii-mundi.md §2). --}}
{{#get "pages" filter="slug:commentarii-mundi" fields="id" limit="1" as |cmHome|}}
    {{#if cmHome}}
        {{> "commentarii-mundi/page-reports" ../this}}
    {{else}}
        {{> "commentarii-mundi/archive-fallback" ../this}}
    {{/if}}
{{/get}}
