{{!< default}}
{{!--
    Individual conflict page — /commentarii-mundi/ukraine/

    Rendered as the index of a routes.yaml collection:

      /commentarii-mundi/ukraine/:
        permalink: /commentarii-mundi/ukraine/{slug}/
        template: cm-conflict
        data: tag.ukraine
        filter: tag:hash-commentarii-mundi+tag:ukraine

    A collection, because reports must live under their conflict at
    /commentarii-mundi/ukraine/{slug}/. Historia Arcana's own posts stay in the
    root collection and keep their URLs.

    This page is the landing page with conflict data: same hero, same filters, same
    feed, same sidebar. Chronologie and Regionen are appended below the feed, since
    they only exist at the conflict level.

    The feed carries Source's .gh-feed class so the theme's existing infinite-scroll
    pagination works here with no extra JavaScript.
--}}

{{#tag}}
    {{> "commentarii-mundi/hero"
        heroTitle=name
        heroSubtitle="Konfliktüberblick"
        heroText=description
        mapScope=slug}}
{{/tag}}

<main class="cm-main gh-outer">
    <div class="cm-main-inner gh-inner">

        {{#tag}}
            {{> "commentarii-mundi/breadcrumb" conflictName=name}}
            {{> "commentarii-mundi/filters" active=slug}}
        {{/tag}}

        <div class="cm-layout">
            <div class="cm-layout-primary">

                {{#tag}}
                    <div class="cm-conflict-headline">
                        <h2 class="cm-conflict-headline-title is-title">Aktuelle Lage</h2>
                        {{> "commentarii-mundi/conflict-severity" conflictSlug=slug}}
                    </div>
                {{/tag}}

                {{#if posts}}
                    <div class="cm-report-list gh-feed">
                        {{#foreach posts}}
                            {{> "commentarii-mundi/report-card" lazyLoad=true hideConflict=true}}
                        {{/foreach}}
                    </div>
                {{else}}
                    <p class="cm-empty is-body">
                        Für diesen Konflikt liegen noch keine Berichte vor.
                    </p>
                {{/if}}

                {{#tag}}
                    {{> "commentarii-mundi/timeline" conflictSlug=slug limit="8"}}
                    {{> "commentarii-mundi/regions" conflictSlug=slug limit="24"}}
                {{/tag}}

            </div>

            {{> "commentarii-mundi/sidebar"}}
        </div>

        {{> "commentarii-mundi/section-conflicts" title="Weitere Konflikte"}}

    </div>
</main>
