{{!--
    Renders the conflict a report belongs to, e.g. "● UKRAINE".

    Must be called from inside a post context.

    Since the publication identifier is the INTERNAL tag #commentarii-mundi, and
    Ghost's primary_tag is always the first PUBLIC tag, the conflict is the primary
    tag by construction. No tag-order tolerance is needed: the internal tag can
    never occupy the primary slot.
--}}
{{#primary_tag}}
    <span class="cm-report-conflict">
        <span class="cm-status-dot" aria-hidden="true"></span>{{name}}
    </span>
{{/primary_tag}}
