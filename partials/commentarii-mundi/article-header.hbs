{{!--
    Commentarii Mundi strip above a report's normal Source article header.

    Renders the publication line, the conflict, its current status and the report
    timestamp — the "COMMENTARII MUNDI / UKRAINE / ● AKTUELL" band from the spec.

    Only ever included from post.hbs behind a {{#has tag="#commentarii-mundi"}} guard,
    so ordinary Historia Arcana archaeology and history posts never see it.

    Must be called from inside a post context.
--}}
<div class="cm-article-strip gh-outer">
    <div class="cm-article-strip-inner gh-inner">
        <a class="cm-article-publication" href="{{@site.url}}/commentarii-mundi/">Commentarii Mundi</a>

        <div class="cm-article-strip-meta">
            {{> "commentarii-mundi/conflict-label"}}
            {{#has tag="#schwerwiegend"}}
                {{> "commentarii-mundi/status" severity="critical"}}
            {{else}}
                {{#has tag="#ernst"}}
                    {{> "commentarii-mundi/status" severity="serious"}}
                {{else}}
                    {{#has tag="#beobachtung"}}
                        {{> "commentarii-mundi/status" severity="watch"}}
                    {{/has}}
                {{/has}}
            {{/has}}
            <span class="cm-article-updated">
                {{> "commentarii-mundi/icons/clock"}}
                Stand: <time datetime="{{date updated_at format="YYYY-MM-DDTHH:mm"}}">{{date updated_at format="DD. MMMM YYYY · HH:mm"}} Uhr</time>
            </span>
            {{> "commentarii-mundi/access-badge"}}
        </div>
    </div>
</div>
